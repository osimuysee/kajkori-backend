# Copy to .env and fill in. NEVER commit .env.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production
# If this is not set the app assumes PRODUCTION (fails closed).
APP_ENV=development

# SQLite locally. On Render use the Postgres URL it gives you.
DATABASE_URL=sqlite:///./sql_app.db

# JWT signing key, also keys the OTP hashes. At least 32 random characters.
# There is NO default in production: if this is missing or shorter than 32
# characters, login and every protected route answer 503 until it is set.
# Changing it logs every user out.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# HMAC key for NID hashes (min 32 chars). Keep it out of the database and git.
# Changing it later invalidates every stored NID hash.
NID_HMAC_PEPPER=

# Greenweb SMS token.
# Empty in production: no SMS is sent and send-otp answers 503 (nothing is logged).
# Empty in development/test: the SMS text is written to the local log instead.
GREENWEB_TOKEN=

# Browser origins allowed to call the API with credentials, comma separated,
# e.g. https://kajkori.example,https://www.kajkori.example
# Empty: any origin may call the API but without credentials (the API uses a
# Bearer token header, so that is enough for the current pages).
CORS_ALLOWED_ORIGINS=

# Shared secret the payment gateway sends to the payments webhook.
PAYMENT_WEBHOOK_SECRET=
